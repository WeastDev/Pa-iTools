<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/picker_bg">

    <!-- ===== Top bar: back + Album dropdown + Cloud + Stock ===== -->
    <ImageButton
        android:id="@+id/btnBack"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="12dp"
        android:layout_marginTop="8dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/back"
        android:padding="8dp"
        android:src="@drawable/ic_back"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <LinearLayout
        android:id="@+id/btnAlbum"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingVertical="8dp"
        app:layout_constraintTop_toTopOf="@id/btnBack"
        app:layout_constraintBottom_toBottomOf="@id/btnBack"
        app:layout_constraintStart_toEndOf="@id/btnBack">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/album"
            android:textColor="@color/text_white"
            android:textSize="19sp"
            android:textStyle="bold" />

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginStart="4dp"
            android:src="@drawable/ic_dropdown" />
    </LinearLayout>

    <TextView
        android:id="@+id/tabStock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="20dp"
        android:text="@string/stock"
        android:textColor="@color/text_white_70"
        android:textSize="16sp"
        app:layout_constraintTop_toTopOf="@id/btnAlbum"
        app:layout_constraintBottom_toBottomOf="@id/btnAlbum"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tabCloud"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="20dp"
        android:text="@string/cloud"
        android:textColor="@color/text_white_70"
        android:textSize="16sp"
        app:layout_constraintTop_toTopOf="@id/btnAlbum"
        app:layout_constraintBottom_toBottomOf="@id/btnAlbum"
        app:layout_constraintEnd_toStartOf="@id/tabStock" />

    <!-- ===== All / Video / Photo filter row ===== -->
    <LinearLayout
        android:id="@+id/filterRow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        app:layout_constraintTop_toBottomOf="@id/btnAlbum"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/btnFilterAll"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginEnd="10dp"
            android:background="@drawable/bg_toggle_white"
            android:gravity="center"
            android:paddingHorizontal="22dp"
            android:text="@string/filter_all"
            android:textColor="@color/text_black"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnFilterVideo"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginEnd="10dp"
            android:background="@drawable/bg_toggle_gray"
            android:gravity="center"
            android:paddingHorizontal="18dp"
            android:text="@string/filter_video"
            android:textColor="@color/text_white"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/btnFilterPhoto"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:background="@drawable/bg_toggle_gray"
            android:gravity="center"
            android:paddingHorizontal="18dp"
            android:text="@string/filter_photo"
            android:textColor="@color/text_white"
            android:textSize="14sp" />

    </LinearLayout>

    <!--
        Guideline just below the filter row: the grid's top padding is pinned to this,
        so scrolled content stops right under the row and never covers it.
    -->
    <View
        android:id="@+id/gridTopSpacer"
        android:layout_width="0dp"
        android:layout_height="10dp"
        app:layout_constraintTop_toBottomOf="@id/filterRow"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ===== Media grid ===== -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerMedia"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingHorizontal="1dp"
        android:paddingBottom="150dp"
        android:scrollbars="vertical"
        app:layout_constraintTop_toBottomOf="@id/gridTopSpacer"
        app:layout_constraintBottom_toTopOf="@id/bottomBarContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:listitem="@layout/item_media_grid" />

    <!-- Empty / permission state -->
    <TextView
        android:id="@+id/txtEmptyState"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="32dp"
        android:gravity="center"
        android:text="@string/permission_needed"
        android:textColor="@color/text_white_70"
        android:textSize="14sp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/gridTopSpacer"
        app:layout_constraintBottom_toTopOf="@id/bottomBarContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ===== Bottom bar: selected clips strip (floats above) + black import bar ===== -->
    <FrameLayout
        android:id="@+id/bottomBarContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Selected clips strip, floats directly above the black bar -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerSelected"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginBottom="2dp"
                android:clipToPadding="false"
                android:orientation="horizontal"
                android:visibility="gone"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:listitem="@layout/item_selected_media"
                tools:visibility="visible" />

            <!-- Black bar with "Please add a clip" text + Import button -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@color/bottom_bar_bg"
                android:paddingHorizontal="16dp"
                android:paddingVertical="14dp">

                <TextView
                    android:id="@+id/txtAddClip"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/please_add_a_clip"
                    android:textColor="@color/text_white_70"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/btnImport"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_import_inactive"
                    android:enabled="false"
                    android:gravity="center"
                    android:paddingHorizontal="26dp"
                    android:text="@string/import_label"
                    android:textColor="@color/text_black"
                    android:textSize="15sp"
                    android:textStyle="bold" />

            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
