<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/thumb_placeholder">

    <ImageView
        android:id="@+id/imgThumb"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:contentDescription="@null" />

    <!-- Video duration badge, bottom-end. Only shown for videos. -->
    <TextView
        android:id="@+id/txtDuration"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="4dp"
        android:background="@drawable/bg_duration_badge"
        android:paddingHorizontal="5dp"
        android:paddingVertical="1.5dp"
        android:textColor="@color/text_white"
        android:textSize="10sp"
        android:visibility="gone"
        tools:text="00:15" />

    <!-- Dark scrim shown when this item is selected -->
    <View
        android:id="@+id/selectionOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/selection_overlay"
        android:visibility="gone" />

    <!-- White border ring shown when this item is selected -->
    <View
        android:id="@+id/selectionBorder"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_thumb_selected_border"
        android:visibility="gone" />

    <!-- Numbered badge showing selection order -->
    <TextView
        android:id="@+id/txtNumber"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_gravity="top|end"
        android:layout_margin="6dp"
        android:background="@drawable/bg_number_badge"
        android:gravity="center"
        android:textColor="@color/text_white"
        android:textSize="12sp"
        android:textStyle="bold"
        android:visibility="gone"
        tools:text="1" />

</FrameLayout>
