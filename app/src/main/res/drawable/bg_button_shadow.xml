<?xml version="1.0" encoding="utf-8"?>
<!--
    Bayangan buatan (fake blurred shadow) untuk tombol hitam.
    Beberapa lapis rounded-rect ditumpuk, makin ke bawah makin lebar
    area inset-nya kecil & makin gelap, supaya kelihatan seperti
    shadow blur yang jatuh di bagian bawah tombol.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item
        android:top="14dp"
        android:left="18dp"
        android:right="18dp"
        android:bottom="0dp">
        <shape android:shape="rectangle">
            <solid android:color="#12000000" />
            <corners android:radius="24dp" />
        </shape>
    </item>

    <item
        android:top="10dp"
        android:left="12dp"
        android:right="12dp"
        android:bottom="2dp">
        <shape android:shape="rectangle">
            <solid android:color="#1A000000" />
            <corners android:radius="24dp" />
        </shape>
    </item>

    <item
        android:top="6dp"
        android:left="6dp"
        android:right="6dp"
        android:bottom="4dp">
        <shape android:shape="rectangle">
            <solid android:color="#26000000" />
            <corners android:radius="24dp" />
        </shape>
    </item>

</layer-list>
